/trust-proxy
*.log
.DS_Store

data/

# shadcn dashboard (our console) — regenerable artifacts
/dashboard/dist
/dashboard/node_modules

# local test fixtures with real node credentials — NEVER tracked
/testdata-local/

# scratch (VM screenshots, diagnosis dumps) + TS incremental build cache
/tmp/
/dashboard/tsconfig.tsbuildinfo

# runtime state that lands in the repo root when serve is run without --data
/cache.db
/clash-secret

# desktop shell (Tauri) — regenerable artifacts
/desktop/node_modules
/desktop/src-tauri/target
/desktop/src-tauri/binaries
/desktop/src-tauri/gen/schemas
/dashboard/.dist-stale-root

# A dist directory left root-owned by a sudo build, moved aside so the next build
# can proceed (see docs/operations.md); the user removes it with sudo.
dashboard/.dist-stale-root-*
