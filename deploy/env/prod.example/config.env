# trust-proxy 生产配置 —— 节点级显式代理入口（DaemonSet）。
#
#   make release-init
#   编辑本文件 → 放好 kubeconfig.yaml → make release ONLY=preflight
#
# 与 lingxiao / ai-router / saidbox 同一 ACK。AI 网关供应源用 proxy_url /
# HTTPS_PROXY 指向本网关；国内直连走集群内地址。

# ═════════════════════════════════════════════════════════
# ① 只有你知道的 —— 必填
# ═════════════════════════════════════════════════════════

# 镜像仓库（不含 tag）。tag 由 make release TAG=… 注入。
# 现网曾用 Specula：specula.learnverse.top/org_default/trust-proxy
# 新发建议迁个人版 ACR（与 ai-router / saidbox 同前缀）：
IMAGE_REPOSITORY=crpi-xxxxxxxx.cn-chengdu.personal.cr.aliyuncs.com/ivanzz/trust-proxy
REGISTRY_HOST=crpi-xxxxxxxx.cn-chengdu.personal.cr.aliyuncs.com
REGISTRY_USER=
REGISTRY_PASSWORD=

# 本机 docker 需 sudo 时置 1
DOCKER_SUDO=0

# ═════════════════════════════════════════════════════════
# ② 密钥 —— make release-init 已生成
# ═════════════════════════════════════════════════════════

API_TOKEN=

# ═════════════════════════════════════════════════════════
# ③ 默认值 —— 一般不用动
# ═════════════════════════════════════════════════════════

NAMESPACE=trust-proxy
RELEASE=trust-proxy
TARGET_PLATFORM=linux/amd64
IMAGE_PULL_SECRET_NAME=trust-proxy-registry
API_SECRET_NAME=trust-proxy
API_TOKEN_KEY=api-token

# 若暂时仍从 Specula 拉镜像、且集群里已有 pull secret，填名字即可（跳过新建 ACR secret）：
# EXISTING_PULL_SECRET=specula-pull

# 预期集群（preflight 用它拦住「打错集群」）
EXPECT_ZONE=cn-chengdu-b

# ⛔ 生产硬约束：manual = 只起 mixed inbound，workload 显式接入。
#    禁止改成 tun（会接管节点转发）。确需 TUN 时另设 ALLOW_TUN_MODE=1。
GATEWAY_MODE=manual
GATEWAY_POSTURE=split
GATEWAY_AUTO_BLOCK=false

# manual 下 nftables 预检非必需。现网曾开着；要关：PREFLIGHT_ENABLED=0
# PREFLIGHT_ENABLED=0
